# Frontend build-time env (Vite). Copy to .env.local and fill what you need.
# All optional for a quick start — see README "Run" for when each is required.

# Dev-server /api proxy target. Default: http://localhost:8000 (local backend).
# Point at a deployed origin to run the frontend on its own:
#   VITE_API_PROXY=https://rumper.web.app
VITE_API_PROXY=

# Google Maps JS key — needed for the result map panel to render.
VITE_GOOGLE_MAPS_KEY=

# Google Identity client ID — needed for the sign-in button.
VITE_GOOGLE_CLIENT_ID=
